# ---- Server ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse-proxy hops in front of the API (0 locally, 1 behind a single proxy)
TRUST_PROXY=0

# ---- Database ----
# Host is 127.0.0.1 (not "localhost") on purpose: "localhost" can resolve to ::1 and reach a *different* PostgreSQL
# (e.g. a native install) than the Docker one, which surfaces as Prisma error P1000. See docs/LOCAL_VERIFICATION.md.
# User/password/db must match the compose defaults (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB).
DATABASE_URL=postgresql://bookleaf:bookleaf_dev@127.0.0.1:5432/bookleaf?schema=public

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
SESSION_TTL_HOURS=168
# Defaults to true in production, false otherwise. Set false only when serving over plain http (e.g. local Docker).
# COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# ---- AI (all optional; with none set the portal works fully manually) ----
# Providers: gemini | openai | anthropic. Set one (primary only) or two (primary + fallback).
# AI_PRIMARY_PROVIDER=gemini
# AI_PRIMARY_MODEL=replace-with-model-name
# AI_PRIMARY_API_KEY=replace-with-api-key
# AI_FALLBACK_PROVIDER=openai
# AI_FALLBACK_MODEL=replace-with-model-name
# AI_FALLBACK_API_KEY=replace-with-api-key
AI_TIMEOUT_MS=25000

# ---- Seed (used only by `npm run db:seed`) ----
# Passwords for the seeded demo accounts. Choose your own; they are never committed.
SEED_AUTHOR_PASSWORD=replace-with-demo-author-password
SEED_ADMIN_PASSWORD=replace-with-demo-admin-password
